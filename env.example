# Example environment variables for Voyara (MongoDB + built-in JWT auth)

# Google Gemini API Key
GOOGLE_API_KEY="YOUR_GOOGLE_GEMINI_API_KEY"

# MongoDB Connection String
MONGODB_URI="mongodb+srv://username:password@your-cluster.mongodb.net/voyara?retryWrites=true&w=majority"

# JWT authentication secret used to sign user tokens
AUTH_SECRET="A_LONG_RANDOM_STRING"

# Share token secret used for itinerary sharing links
SHARE_TOKEN_SECRET="ANOTHER_LONG_RANDOM_STRING"

# Optional: JWT used by integration tests
TEST_AUTH_TOKEN="YOUR_TEST_AUTH_JWT"
