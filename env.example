# Example environment variables for Voyara

# Google Gemini API Key
GOOGLE_API_KEY="YOUR_GOOGLE_GEMINI_API_KEY"

# Optional: preferred Gemini model(s). Comma-separated fallback order supported.
# Example: GOOGLE_MODEL="gemini-1.5-flash,gemini-2.0-flash"
GOOGLE_MODEL="gemini-1.5-flash,gemini-2.0-flash"

# MongoDB Connection URI (local or Atlas)
# Local: mongodb://127.0.0.1:27017/voyara
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/voyara
MONGODB_URI="mongodb://127.0.0.1:27017/voyara"

# JWT authentication secret used to sign user tokens (minimum 32 chars)
AUTH_SECRET="A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
AUTH_ISSUER="voyara"
AUTH_AUDIENCE="voyara-web"

# Share token secret used for itinerary sharing links
SHARE_TOKEN_SECRET="ANOTHER_LONG_RANDOM_STRING"

# Optional: JWT used by integration tests
TEST_AUTH_TOKEN="YOUR_TEST_AUTH_JWT"
